{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version 1 compaction trace",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "compaction_trace"
    },
    "boundary_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "origin": {
      "enum": [
        "synthetic",
        "observed"
      ]
    },
    "before": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "after": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "registry": {
      "$ref": "#/$defs/registry"
    },
    "expected": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "enum": [
          "preserved",
          "missing",
          "weakened",
          "contradicted",
          "uncertain"
        ]
      }
    },
    "before_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "after_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "kind",
    "boundary_id",
    "origin",
    "before",
    "after",
    "registry",
    "expected",
    "before_sha256",
    "after_sha256"
  ],
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1000000
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "source_type": {
          "enum": [
            "instruction",
            "conversation",
            "summary",
            "tool_result",
            "reference",
            "restored_constraint"
          ]
        },
        "registry_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "sequence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "restored_constraint"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "registry_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "constraint_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "constraint_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "registry_id",
              "constraint_id",
              "constraint_version"
            ]
          },
          "else": {
            "properties": {
              "registry_id": {
                "type": "null"
              },
              "constraint_id": {
                "type": "null"
              },
              "constraint_version": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "instruction"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "developer",
                  "user"
                ]
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "#/$defs/message"
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_revision": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "revoked",
            "ended"
          ]
        },
        "ended_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "version",
        "source",
        "span_start",
        "span_end",
        "task_id",
        "created_revision",
        "status",
        "ended_revision"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 2
        },
        "registry_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "uniqueItems": true
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "required": [
        "version",
        "registry_id",
        "session_id",
        "revision",
        "task_id",
        "closed_tasks",
        "records"
      ]
    }
  }
}
