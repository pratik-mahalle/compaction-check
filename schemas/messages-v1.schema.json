{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete structured message context",
  "type": "array",
  "maxItems": 10000,
  "items": {
    "$ref": "#/$defs/message"
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 1000000
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "source_type": {
          "enum": [
            "instruction",
            "conversation",
            "summary",
            "tool_result",
            "reference",
            "restored_constraint"
          ]
        },
        "registry_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "sequence"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "restored_constraint"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "registry_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "constraint_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "constraint_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "registry_id",
              "constraint_id",
              "constraint_version"
            ]
          },
          "else": {
            "properties": {
              "registry_id": {
                "type": "null"
              },
              "constraint_id": {
                "type": "null"
              },
              "constraint_version": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "instruction"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "developer",
                  "user"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
